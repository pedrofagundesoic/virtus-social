# ── Meta (FASE 1). NUNCA no git. Copie para C:\Users\pedro\.social.env
FB_APP_ID=
FB_APP_SECRET=
FB_USER_TOKEN_SHORT=            # colado do Graph API Explorer (expira em ~1h; só usado uma vez)
FB_USER_TOKEN_LONGLIVED=        # escrito por scripts/meta-token.ps1 (60 dias)
FB_PAGE_ID=
FB_PAGE_TOKEN=                  # escrito por scripts/meta-token.ps1 — não expira
IG_USER_ID=                     # escrito por scripts/meta-token.ps1

# ── Publisher (no GitHub: Secrets FB_PAGE_ID FB_PAGE_TOKEN IG_USER_ID; Variables abaixo)
SOCIAL_MANIFEST_URL=https://pedrofagundesoic.github.io/virtus-social/social/queue.json
SOCIAL_TZ=America/Sao_Paulo
SOCIAL_POST_HOUR=18
SOCIAL_REPEAT_DAYS=21
SOCIAL_ENABLED=false            # Variable do GitHub: "true" arma o workflow diário

# ── Compositor (só local)
SOCIAL_WEB_DIR=C:\dev\Virtus\docs\social
VIRTUS_DEMO_EMAIL=
VIRTUS_DEMO_PASSWORD=
